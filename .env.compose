# ─────────────────────────────────────────────
# Docker Compose Environment File
# ─────────────────────────────────────────────
# Digunakan oleh: docker compose --env-file .env.compose up -d
# File ini hanya berisi variable yang dipakai di docker-compose.yml
# (menghindari konflik interpolation dengan $ dari API key/token)

WWWGROUP=1000
WWWUSER=1000

# Port mapping
APP_PORT=80
VITE_PORT=5173
FORWARD_REDIS_PORT=6380
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
